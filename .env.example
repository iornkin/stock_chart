# ─────────────────────────────────────────────────────────────
# US Stock Insight 환경변수 예시 — .env 로 복사해서 사용하세요.
# API 키는 서버에서만 읽으며 브라우저로 전달되지 않습니다.
# ─────────────────────────────────────────────────────────────

# SQLite 데이터 파일 경로 (웹 서버와 워커가 같은 파일을 사용해야 함)
DATABASE_PATH=./data/app.db

# 관리자 토큰: 설정 페이지에서 업데이트 일정 변경·수동 실행에 사용 (비워 두면 관리자 기능 비활성)
ADMIN_TOKEN=

# ── 키가 필요 없는 제공처 (기본 사용) ──
ENABLE_YAHOO=true          # 시세·차트·배당 이벤트·ETF/기업 지표·뉴스 헤드라인 (비공식)
ENABLE_NASDAQ=true         # 배당·분배금 지급일/선언일/기준일 (비공식)
ENABLE_GOOGLE_NEWS=true    # ETF·기초자산 관련 뉴스 RSS

# ── 무료 키/설정 권장 ──
# SEC EDGAR: 연락처가 들어간 User-Agent 필수 (예: "MyStockSite yourname@example.com")
SEC_USER_AGENT=
# Finnhub (무료 플랜): 기업 뉴스(요약 포함)·시장 뉴스·실적 발표 일정·기본 지표
FINNHUB_API_KEY=
# FRED (무료): 국채금리·달러지수·경제지표 발표 일정
FRED_API_KEY=

# ── 선택 ──
# Polygon.io / Massive (무료 플랜 분당 5회): 배당 지급 주기·유형, 뉴스
POLYGON_API_KEY=
# Alpha Vantage (무료 하루 25회): ETF 총보수·순자산·편입 종목 보완
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_BUDGET=20

# ── (선택) AI 브리핑 서술·뉴스 한국어 요약: Anthropic Claude API ──
# 설정하지 않으면 규칙 기반 브리핑만 생성됩니다. 사용량에 따라 비용이 발생합니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# AI 서술을 붙일 브리핑 종류: intraday, close, non_trading, market (쉼표 구분)
LLM_SESSIONS=close,market

# ── 운영 옵션 ──
# 화면 조회 시 캐시가 만료되었으면 제공처에서 직접 받아올지 여부
ON_DEMAND_FETCH=true
# 정적 사이트(GitHub Pages)용: 1시간·주·월봉과 장중 5분봉을 수집 작업에서 미리 받기 (워크플로가 자동 설정)
COLLECT_ALL_INTERVALS=false
HTTP_TIMEOUT_MS=15000
# 워커 점검 주기(ms)
WORKER_TICK_MS=30000
